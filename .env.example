# ─── Luna Agent — variáveis de ambiente (F1.1 Foundation) ───────────────────
# Copie para .env e ajuste. NUNCA commite .env. Secrets vivem em env /
# credential store do SO (Arquitetura §21) — nunca em logs, Brain ou commits.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ── HTTP (orchestrator) ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3100

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Dev default: container local (ver scripts/start-postgres.sh).
# Atenção Windows: a porta 5432 do host costuma estar ocupada por um Postgres
# nativo — por isso o container mapeia 5433->5432. Em prod, definir via env.
DATABASE_URL=postgres://luna:luna@localhost:5433/luna

# ── Boot ─────────────────────────────────────────────────────────────────────
# Se true, o orchestrator aplica migrações pendentes ao subir.
RUN_MIGRATIONS_ON_BOOT=true

# ── Testes de integração (opcional) ─────────────────────────────────────────
# Banco dedicado criado/derrubado automaticamente pelos testes. Nunca o `luna` de dev.
# TEST_DATABASE_URL=postgres://luna:luna@localhost:5433/luna_test
