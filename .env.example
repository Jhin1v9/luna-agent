# ─── Luna Agent — variáveis de ambiente (F1.1 Foundation) ───────────────────
# Copie para .env e ajuste. NUNCA commite .env. Secrets vivem em env /
# credential store do SO (Arquitetura §21) — nunca em logs, Brain ou commits.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ── HTTP (orchestrator) ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3100

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Dev default: container local (ver scripts/start-postgres.sh).
# Atenção Windows: a porta 5432 do host costuma estar ocupada por um Postgres
# nativo — por isso o container mapeia 5433->5432. Em prod, definir via env.
DATABASE_URL=postgres://luna:luna@localhost:5433/luna

# ── Boot ─────────────────────────────────────────────────────────────────────
# Se true, o orchestrator aplica migrações pendentes ao subir.
RUN_MIGRATIONS_ON_BOOT=true

# ── KimiAdapter — cérebro vivo (§7.3, ADR-010/015/016) ───────────────────────
# mock = determinístico, sem rede (SÓ dev/testes — ADR-016 proíbe mock em
# produção; o orchestrator recusa boot com NODE_ENV=production + mock).
# kimi-web = servidor local kimi web em 127.0.0.1 (sendTurn via WS ainda
# não mapeado — ver docs/adr/ADR-015; REST de sessões já funciona).
# kimi-api = FAST BRAIN REAL (§7.2) — resposta de cliente sai daqui.
KIMI_ADAPTER_MODE=mock
KIMI_WEB_URL=http://127.0.0.1:58627
# Token bearer impresso na subida do `kimi web` — NUNCA commite.
# KIMI_WEB_TOKEN=
# Kimi API (fast brain — key da plataforma). SEM fallback: se ausente, o
# fluxo de cliente falha EXPLICITAMENTE (retry → DLQ), nunca cai pro mock.
# KIMI_API_KEY=
KIMI_API_BASE_URL=https://api.moonshot.ai/v1
KIMI_API_MODEL=kimi-k2-0905-preview

# ── WhatsPlay (§13) ─────────────────────────────────────────────────────────
# Chrome DEDICADO (nunca o perfil do Chrome do usuário). Sessão pareada uma
# vez com: pnpm --filter whatsplay login  (QR manual, janela headful).
WHATSAPP_CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# WHATSAPP_USER_DATA_DIR=C:/Users/Abner/.luna/chrome-whatsapp
WHATSAPP_HEADLESS=false
WHATSAPP_DEBOUNCE_MS=4000

# ── Telegram fallback vivo (§15) ────────────────────────────────────────────
# Sessão WhatsApp caiu → msg ao time com contexto. Token NUNCA commite.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_TEAM_CHAT_ID=

# ── Reaper de locks (worker) ────────────────────────────────────────────────
# Locks 'running' travados há mais que isso voltam para a fila.
LOCK_REAPER_TIMEOUT_MS=300000

# ── Testes de integração (opcional) ─────────────────────────────────────────
# Banco dedicado criado/derrubado automaticamente pelos testes. Nunca o `luna` de dev.
# TEST_DATABASE_URL=postgres://luna:luna@localhost:5433/luna_test

# LLM — contrato Model Router §9 (troca de provider = só .env). Decreto: modelo
# mais barato, NUNCA 2.7, NUNCA K3 (ADR-019). Key do Kimi Coding Plan:
# LLM_PROVIDER=kimi / LLM_BASE_URL=https://api.kimi.com/coding/v1 / LLM_MODEL=kimi-k2.6
LLM_PROVIDER=kimi
LLM_BASE_URL=https://api.kimi.com/coding/v1
# LLM_API_KEY=
LLM_MODEL=kimi-k2.6

# Anti-ban (ADR-004): espera humana antes de entregar resposta no WhatsApp
HUMAN_RESPONSE_DELAY_MS=3500

# GUARDRAIL DE CÓDIGO (decreto do owner, ADR-020): fora de produção, SÓ estes
# contatos (nome ou jid, separados por vírgula) recebem mensagem da Luna.
# Lista VAZIA em dev = recusa TUDO (fail-closed). Em produção não se aplica.

# ESCOPO DE TESTE (decreto do owner, ADR-020): SÓ estes dois destinos podem
# receber mensagem da Luna, e SÓ conversas desta lista são processadas (zero
# tokens fora do escopo — nem abre o chat, nem chama LLM). Listas VAZIAS em
# dev = nada enviado/processado (fail-closed). Em produção não se aplicam.

# ESCOPO DE TESTE (decreto do owner, ADR-020): SÓ estes destinos podem
# receber mensagem da Luna, e SÓ conversas desta lista são processadas (zero
# tokens fora do escopo — nem abre o chat, nem chama LLM). Listas VAZIAS em
# dev = nada enviado/processado (fail-closed). Em produção não se aplicam.
# Match: nome exato (normaliza marcas invisíveis de bidi) ou jid por sufixo.
# WHATSAPP_OUTBOUND_ALLOWLIST=Pai,🏆Production - 2026🙏🏻,34685093192@s.whatsapp.net
# WHATSAPP_INGEST_ALLOWLIST=Pai,🏆Production - 2026🙏🏻,34685093192@s.whatsapp.net

# ── F2 — Canais de notificação (§22, fail-closed; ADR-025) ──────────────────
# Email via SMTP (connection string). Sem = canal falha explicitamente.
# SMTP_URL=smtp://user:pass@smtp.host:587
# SMTP_FROM=Luna <luna@nexo-digital.local>
# Push PWA (Web Push/VAPID). Gere um par: pnpm --filter @luna/channels vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:luna@nexo-digital.local

# ── F2 — Endpoint do workspace (POST /v1/events) ────────────────────────────
# Token de serviço (Bearer). Sem = endpoint 503 fail-closed. Exemplo de uso:
# curl -X POST http://localhost:3100/v1/events \
#   -H "Authorization: Bearer $WORKSPACE_SERVICE_TOKEN" -H "content-type: application/json" \
#   -d '{"event_type":"task.completed","payload":{"task_id":"42"},"idempotency_key":"ws:task:42"}'
# WORKSPACE_SERVICE_TOKEN=
