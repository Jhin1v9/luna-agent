# ============================================================
# Luna Kernel v5.0 — Environment Configuration
# NEXO DIGITAL S.L.
# ============================================================

# ── REQUIRED ──

# Telegram Bot Token (get from @BotFather: https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Internal API Token for NEXO Dashboard
INTERNAL_API_TOKEN=your_dashboard_api_token_here

# JWT Secret for web sessions (min 32 chars)
JWT_SECRET=your_jwt_secret_here_min_32_chars

# ── OPTIONAL (have defaults) ──

# Search API keys — required for reliable web search results.
# Without these, searchWeb falls back to scraping and usually fails due to bot protection.
# SERP_API_KEY: https://serpapi.com/manage-api-key
# BRAVE_API_KEY: https://api.search.brave.com/app/keys
# SERP_API_KEY=your_serpapi_key_here
# BRAVE_API_KEY=your_brave_key_here

# Kimi Bridge Settings
KIMI_TIMEOUT=120000
KIMI_MAX_PAGES=5
KIMI_IDLE_TIMEOUT=600000
KIMI_COOLDOWN_MS=5000
KIMI_MAX_TYPE_LENGTH=500
KIMI_LOG_MAX_MB=10

# Context Auto-Compaction
LUNA_COMPACT_THRESHOLD=24
LUNA_COMPACT_TOKEN_THRESHOLD=120000

# Chrome Path (auto-detected if not set)
# LUNA_CHROME_PATH=/usr/bin/google-chrome

# Debug Mode
# LUNA_DEBUG=true

# Admin Mode — when true, path guard is disabled and Luna can read/write anywhere.
# Destructive operations (delete, rm, format, etc.) still require UI confirmation.
# LUNA_ADMIN_MODE=true

# Web Server Port
LUNA_CONFIG_PORT=3458
