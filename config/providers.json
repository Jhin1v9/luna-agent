{
  "_about": "Isolated Superclim provider wheel. Add API keys only through local env files.",
  "fastBrain": "pollinations",
  "liveBrain": "pollinations",
  "providers": [
    {
      "id": "gemini",
      "label": "Gemini Flash (Google)",
      "model": "gemini-2.5-flash",
      "transport": "openai",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "apiKeyEnv": "GEMINI_API_KEY",
      "priority": 10,
      "enabled": false,
      "role": "ambos"
    },
    {
      "id": "github-gpt4o",
      "label": "GitHub Models GPT-4o",
      "model": "openai/gpt-4o",
      "transport": "openai",
      "baseUrl": "https://models.github.ai/inference",
      "apiKeyEnv": "GITHUB_TOKEN",
      "priority": 20,
      "enabled": false,
      "role": "chat"
    },
    {
      "id": "pollinations",
      "label": "Pollinations (sem key)",
      "model": "openai",
      "transport": "openai",
      "baseUrl": "https://text.pollinations.ai/openai",
      "apiKeyEnv": null,
      "priority": 90,
      "enabled": true,
      "role": "ambos"
    }
  ]
}
